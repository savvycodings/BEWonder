# Copy to .env and fill in. Never commit real .env.

DATABASE_URL=

# Admin orders (Settings → View orders in the app)
ADMIN_ORDERS_PASSWORD=
ADMIN_JWT_SECRET=

# Resend — password reset + sign-in/sign-up email codes (https://resend.com)
RESEND_API_KEY=
# Sender must be a verified domain in Resend (testing: Wonderport <onboarding@resend.dev>)
# IMPORTANT: onboarding@resend.dev only delivers to your Resend account email.
# After verifying your domain (DNS in Resend dashboard), use an address on that domain:
AUTH_EMAIL_FROM=Wonderport <noreply@altitudedl.co.za>
# Legacy alias (optional; AUTH_EMAIL_FROM takes precedence)
PASSWORD_RESET_FROM_EMAIL=
# Dev: log OTPs to AP I console when Resend is not configured
AUTH_EMAIL_LOG_OTP=true
PASSWORD_RESET_LOG_OTP=true
# Require signup email code before /auth/register (after /auth/email-code/verify with purpose signup)
AUTH_REQUIRE_SIGNUP_EMAIL_VERIFY=false

# Admin email when an order is paid (defaults to info@wonderporthobbies.com)
ORDER_ADMIN_NOTIFY_EMAIL=info@wonderporthobbies.com

# Yoco Checkout API (https://developer.yoco.com/docs/checkout-api) — secret key server-side only
# Your own keys: test card is in Yoco App → Sales → Payment Gateway (under Test keys), NOT always 4111…
# Yoco doc demo keys (card 4111 1111 1111 1111): sk_test_960bfde0VBrLlpK098e4ffeb53e1 / pk_test_ed3c54a6gOol69qa7f45
YOCO_SECRET_KEY=
YOCO_PUBLIC_KEY=
# Application id from Yoco developer portal (optional, for your records).
YOCO_APPLICATION_ID=
# Webhook signing secret from Yoco portal (yoco_live_... or whsec_...) — NOT required for the card form.
# Required to auto-mark orders paid without tapping "Check status" in the app.
# 1) Expose server: ngrok http 3050  →  https://xxxx.ngrok-free.app
# 2) Yoco portal → Developers → Webhooks → URL https://xxxx.ngrok-free.app/webhooks/yoco
# 3) Events: payment.succeeded, payment.failed  →  copy signing secret here
YOCO_WEBHOOK_SECRET=
# Base URL for payment return pages (must match what the app WebView can reach, e.g. http://192.168.1.10:3050)
YOCO_RETURN_BASE_URL=http://localhost:3050

EFT_ACCOUNT_NAME=WonderPort
EFT_ACCOUNT_NUMBER=4116973995
EFT_BANK_NAME=ABSA
EFT_BRANCH_CODE=632005

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shopify catalog sync (`pnpm shopify:sync` or POST /admin/shopify/sync-catalog)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Admin token (shpat_…) scopes: read_products, read_inventory, write_inventory (mark-sold adjusts Shopify stock).
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Optional: gid://shopify/Location/… — defaults to first active location if unset.
SHOPIFY_INVENTORY_LOCATION_ID=
SHOPIFY_ADMIN_API_VERSION=2025-01
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# The Courier Guy / ShipLogic
# Use the API base URL shown in your ShipLogic portal (production often https://api.portal.thecourierguy.co.za — confirm sandbox host in portal docs).
TCG_ENABLED=false
TCG_API_BASE_URL=
TCG_API_KEY=
# If the portal shows id|secret, we send only the part AFTER "|" as Bearer by default. Use "full" to send the whole TCG_API_KEY, or set TCG_BEARER_TOKEN to exactly what ShipLogic shows for Authorization.
# TCG_API_KEY_BEARER_PAsRT=auto
# TCG_API_KEY_BEARER_PART=full
# TCG_BEARER_TOKEN=
# Optional: append ?account_id= to account-scoped API calls (see Postman “Accounts API”). Must match the account for this API key or you may get 403.
TCG_ACCOUNT_ID=
# Warehouse / collecstion (JSON). Example: {"type":"business","company":"WonderPort","street_address":"1 Example Rd","local_area":"Suburb","city":"Johannesburg","zone":"GP","country":"ZA","code":"2196"}
TCG_COLLECTION_ADDRESS_JSON=
# JSON: {"name":"Dispatch","mobile_number":"0820000000","email":"dispatch@example.com"}
TCG_COLLECTION_CONTACT_JSON=
TCG_DEFAULT_PARCEL_LENGTH_CM=60
TCG_DEFAULT_PARCEL_WIDTH_CM=17
TCG_DEFAULT_PARCEL_HEIGHT_CM=8
TCG_DEFAULT_PARCEL_WEIGHT_KG=2s
# Fallback parcel when vadriant title indicates a whole set (until Shopify package/weight is filled in).
TCG_DEFAULT_SETd_PARCEL_LENGTH_CM=60
TCG_DEFAUdLT_dSET_PARCEL_WIDTH_CM=41
TCG_DEFAULT_SET_PARCEL_HEIGHT_CM=17
TCG_DEFAULT_SET_PARCEL_WEIGHT_KG=5
# If set, skips POST /rates and uses this code (e.g. ECO). Leave empty to derive from /rates response.
TCG_SERVICE_LEVEL_CODE=
# Pudo locker deliveries: ShipLogic pickup point id (e.g. from pickup-points API). If empty, locker orders use entered_address text instead.
TCG_PUDO_DELIVERY_PICKUP_POINT_ID=
# Sandbox-friendly defaults (see Postman examples).
TCG_MUTE_NOTIFICATIONS=true
TCG_SPECIAL_INSTRUCTIONS_COLLECTION=
TCG_SPECIAL_INSTRUCTIONS_DELIVERY=
# Inbound webhook auth: send header X-Tcg-Webhook-Secret with this value from ShipLogic → Settings → Webhook subscriptions.
TCG_WEBHOOK_SECRET=
